#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "sambot"
    doc = """Generated from Composed Stage of root layer /tmp/tmp_perl612/sambot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_sambot_qoqr5gjq/usdex_sambot/sambot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_sambot_qoqr5gjq/temp_sambot/sambot.usd


Generated from Composed Stage of root layer /home/abhinandas/ws/robotics/ros2/nav2_ws/src/sambot_pkgs/sambot_isaac/usd/sambot/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "sambot" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

over "Flattened_Prototype_5"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_5.inputs:diffuseColor>
        float inputs:metallic.connect = </Flattened_Prototype_5.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_5.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_5.inputs:roughness>
        token outputs:displacement
        token outputs:surface
    }
}

