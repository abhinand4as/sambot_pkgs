#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "sambot"
    doc = """Generated from Composed Stage of root layer /tmp/tmp_perl612/sambot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_sambot_qoqr5gjq/usdex_sambot/sambot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_sambot_qoqr5gjq/temp_sambot/sambot.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "sambot" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </sambot/Physics/base_joint>,
        </sambot/Physics/drivewhl_l_joint>,
        </sambot/Physics/drivewhl_r_joint>,
        </sambot/Physics/caster_joint>,
        </sambot/Physics/lidar_joint>,
        </sambot/Physics/camera_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </sambot/Geometry/base_link>,
        </sambot/Geometry/base_link/base_footprint>,
        </sambot/Geometry/base_link/drivewhl_l_link>,
        </sambot/Geometry/base_link/drivewhl_r_link>,
        </sambot/Geometry/base_link/front_caster>,
        </sambot/Geometry/base_link/lidar_link>,
        </sambot/Geometry/base_link/camera_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "drivewhl_l_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "drivewhl_r_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "front_caster" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "base_footprint" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "lidar_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "camera_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "base_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "drivewhl_l_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "drivewhl_r_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "caster_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "lidar_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "camera_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

