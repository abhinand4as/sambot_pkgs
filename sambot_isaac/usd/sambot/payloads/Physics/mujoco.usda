over "sambot"
{
    over "Physics"
    {
        def MjcActuator "drivewhl_l_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -17.453292846679688, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            uniform double[] mjc:gainPrm = [17.453292846679688, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </sambot/Physics/drivewhl_l_joint>
        }

        def MjcActuator "drivewhl_r_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -17.453292846679688, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            uniform double[] mjc:gainPrm = [17.453292846679688, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </sambot/Physics/drivewhl_r_joint>
        }

        over "base_joint"
        {
        }

        over "drivewhl_l_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
